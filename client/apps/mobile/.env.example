# OPAD Mobile — Environment Variables
#
# Copy this file to `.env.local` and adjust values for your environment.
# `.env.local` is gitignored.
#
# IMPORTANT: Variables must be prefixed with EXPO_PUBLIC_ to be exposed to
# the client bundle (Expo SDK convention).

# FastAPI base URL — depends on where you're running the app:
#
#   iOS Simulator:        http://localhost:8001
#   Android Emulator:     http://10.0.2.2:8001         (10.0.2.2 = host machine)
#   Physical device:      http://<your-LAN-IP>:8001    (e.g. http://192.168.0.42:8001)
#   Production:           https://api.opad.example.com
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
