# Dockerfile for API service (FastAPI)
FROM python:3.12-slim

# Install system dependencies (jemalloc for memory fragmentation mitigation, see #157)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjemalloc2 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files
COPY . /app

# Install Python dependencies
RUN pip install --no-cache-dir --break-system-packages -e ".[api]"

# Use jemalloc to prevent glibc malloc arena fragmentation (see #157)
# PyTorch CPU tensors (via Stanza) leak ~800MB on idle unload with default glibc
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2

# jemalloc tuning for aggressive memory return (see #157):
# - thp:never            disable Transparent Huge Pages (2MB chunks pin small allocs)
# - dirty_decay_ms:1000  return dirty pages to OS after 1s (default 10s)
# - muzzy_decay_ms:0     return muzzy pages immediately (default 10s)
# - background_thread    enable background purge thread
ENV MALLOC_CONF=thp:never,dirty_decay_ms:1000,muzzy_decay_ms:0,background_thread:true

# Set Python path
ENV PYTHONPATH=/app/server

# Expose port (Railway will set PORT env var)
EXPOSE 8000

# Start FastAPI server - log to stdout for Railway
# Disable access logs to reduce noise (application logs via structured logging)
CMD sh -c "echo 'Starting API server on port '${PORT:-8000} && uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --log-level info --no-access-log"

